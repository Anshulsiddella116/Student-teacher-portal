<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EduSync — Student & Teacher Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #f9f5ef;
    --warm-white: #fdf9f4;
    --ink: #1a1612;
    --ink-muted: #5a524a;
    --ink-light: #9e9188;
    --gold: #c9933a;
    --gold-light: #f0d9b0;
    --gold-pale: #faf3e6;
    --rust: #b85c3a;
    --rust-light: #f5ddd6;
    --sage: #4a7c5f;
    --sage-light: #d4e8db;
    --border: rgba(26,22,18,0.1);
    --border-strong: rgba(26,22,18,0.2);
    --shadow-sm: 0 2px 8px rgba(26,22,18,0.06);
    --shadow-md: 0 8px 32px rgba(26,22,18,0.1);
    --shadow-lg: 0 24px 64px rgba(26,22,18,0.14);
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'DM Sans', system-ui, sans-serif;
    --radius: 16px;
    --radius-sm: 8px;
    --radius-xs: 4px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: var(--font-body);
    background: var(--cream);
    color: var(--ink);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    top: -120px; right: -120px;
    width: 480px; height: 480px;
    background: radial-gradient(circle, var(--gold-light) 0%, transparent 70%);
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }
  body::after {
    content: '';
    position: fixed;
    bottom: -80px; left: -80px;
    width: 360px; height: 360px;
    background: radial-gradient(circle, var(--sage-light) 0%, transparent 70%);
    opacity: 0.4;
    pointer-events: none;
    z-index: 0;
  }

  .screen { display: none; position: relative; z-index: 1; }
  .screen.active { display: block; animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both; }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* LANDING */
  .landing-wrap {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .landing-hero {
    background: var(--ink);
    color: var(--cream);
    padding: 64px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .landing-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(201,147,58,0.04) 40px, rgba(201,147,58,0.04) 41px);
  }
  .hero-logo {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 56px;
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
  }
  .hero-logo span { display: inline-block; width: 28px; height: 2px; background: var(--gold); }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.5vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 20px;
    position: relative;
  }
  .hero-title em { font-style: italic; color: var(--gold); }
  .hero-sub {
    font-size: 15px;
    color: rgba(249,245,239,0.55);
    line-height: 1.75;
    max-width: 340px;
    margin-bottom: 48px;
    position: relative;
  }
  .hero-stats { display: flex; gap: 32px; position: relative; }
  .stat-num { font-family: var(--font-display); font-size: 28px; font-weight: 600; color: var(--gold); }
  .stat-label { font-size: 11px; color: rgba(249,245,239,0.45); letter-spacing: 0.06em; text-transform: uppercase; margin-top: 2px; }
  .hero-deco {
    position: absolute;
    right: -40px; bottom: 40px;
    width: 200px; height: 200px;
    border: 1px solid rgba(201,147,58,0.15);
    border-radius: 50%;
  }
  .hero-deco::before {
    content: '';
    position: absolute;
    inset: 20px;
    border: 1px solid rgba(201,147,58,0.1);
    border-radius: 50%;
  }

  .landing-form-side {
    background: var(--warm-white);
    padding: 64px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .form-header { margin-bottom: 28px; }
  .form-header h2 { font-family: var(--font-display); font-size: 26px; font-weight: 600; margin-bottom: 5px; }
  .form-header p { font-size: 14px; color: var(--ink-light); }

  .role-tabs {
    display: flex;
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 4px;
    margin-bottom: 24px;
    gap: 4px;
  }
  .role-tab {
    flex: 1; padding: 9px 16px;
    font-family: var(--font-body); font-size: 13px; font-weight: 500;
    cursor: pointer; border: none; border-radius: 6px;
    background: transparent; color: var(--ink-muted);
    transition: all 0.2s ease;
  }
  .role-tab.active { background: var(--ink); color: var(--cream); }

  .field { margin-bottom: 14px; }
  .field label {
    display: block; font-size: 11px; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-muted); margin-bottom: 6px;
  }
  .field input, .field textarea {
    width: 100%; padding: 11px 14px;
    font-family: var(--font-body); font-size: 14px; color: var(--ink);
    background: var(--cream); border: 1px solid var(--border);
    border-radius: var(--radius-sm); outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field input:focus, .field textarea:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px var(--gold-pale);
  }
  .field textarea { height: 90px; resize: vertical; }

  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

  .btn-primary {
    width: 100%; padding: 13px 20px;
    font-family: var(--font-body); font-size: 14px; font-weight: 600;
    letter-spacing: 0.02em; color: var(--cream);
    background: var(--ink); border: none;
    border-radius: var(--radius-sm); cursor: pointer;
    transition: all 0.2s ease; margin-top: 6px;
  }
  .btn-primary:hover { background: #2e2820; transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .btn-primary:active { transform: translateY(0); }

  .btn-signout {
    padding: 7px 16px; font-family: var(--font-body); font-size: 13px; font-weight: 500;
    color: var(--cream); background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius-sm);
    cursor: pointer; transition: all 0.2s;
  }
  .btn-signout:hover { background: rgba(255,255,255,0.16); }

  .btn-danger {
    padding: 6px 12px; font-family: var(--font-body); font-size: 12px; font-weight: 500;
    color: var(--rust); background: transparent;
    border: 1px solid rgba(184,92,58,0.3);
    border-radius: var(--radius-xs); cursor: pointer; transition: all 0.2s;
  }
  .btn-danger:hover { background: var(--rust-light); }

  .link-toggle {
    display: block; text-align: center; margin-top: 14px;
    font-size: 13px; color: var(--ink-light); cursor: pointer;
  }
  .link-toggle strong { color: var(--gold); font-weight: 600; }

  .msg {
    padding: 10px 14px; border-radius: var(--radius-sm);
    font-size: 13px; margin-bottom: 12px; display: none;
  }
  .msg.err { display: block; background: var(--rust-light); color: var(--rust); border: 1px solid rgba(184,92,58,0.2); }
  .msg.ok { display: block; background: var(--sage-light); color: var(--sage); border: 1px solid rgba(74,124,95,0.2); }

  /* DASHBOARDS */
  .dashboard-wrap {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 240px 1fr;
    grid-template-rows: 64px 1fr;
  }
  .topbar {
    grid-column: 1 / -1;
    background: var(--ink);
    padding: 0 28px;
    display: flex; align-items: center; justify-content: space-between;
    position: sticky; top: 0; z-index: 100;
  }
  .topbar-brand {
    font-family: var(--font-display);
    font-size: 18px; font-weight: 700; color: var(--gold);
    display: flex; align-items: center; gap: 10px;
  }
  .live-dot {
    width: 8px; height: 8px;
    background: var(--gold); border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.35} }
  .topbar-right { display: flex; align-items: center; gap: 14px; }
  .user-chip { display: flex; align-items: center; gap: 10px; }
  .user-info { text-align: right; }
  .user-name { font-size: 14px; font-weight: 500; color: var(--cream); }
  .user-role { font-size: 11px; color: rgba(249,245,239,0.4); text-transform: uppercase; letter-spacing: 0.08em; }
  .avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--gold); color: var(--ink);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700; flex-shrink: 0;
  }

  .sidebar {
    background: var(--warm-white);
    border-right: 1px solid var(--border);
    padding: 24px 16px;
    display: flex; flex-direction: column; gap: 3px;
  }
  .sidebar-label {
    font-size: 10px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-light);
    padding: 0 10px; margin-bottom: 6px; margin-top: 12px;
  }
  .sidebar-label:first-child { margin-top: 0; }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px; border-radius: var(--radius-sm);
    font-size: 14px; font-weight: 400; color: var(--ink-muted);
    cursor: pointer; border: none; background: transparent;
    width: 100%; text-align: left; transition: all 0.15s;
  }
  .nav-item:hover { background: var(--cream); color: var(--ink); }
  .nav-item.active { background: var(--ink); color: var(--cream); font-weight: 500; }
  .nav-icon { font-size: 15px; width: 20px; text-align: center; }

  .main-content { padding: 32px 36px; overflow-y: auto; }
  .page-header { margin-bottom: 28px; }
  .page-title { font-family: var(--font-display); font-size: 26px; font-weight: 700; margin-bottom: 4px; }
  .page-sub { font-size: 13px; color: var(--ink-light); }

  .form-card {
    background: var(--warm-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px; max-width: 600px;
    box-shadow: var(--shadow-sm);
  }
  .form-card h3 {
    font-family: var(--font-display); font-size: 17px; font-weight: 600;
    margin-bottom: 20px; padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .assignments-grid { display: flex; flex-direction: column; gap: 12px; max-width: 780px; }
  .assignment-card {
    background: var(--warm-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 22px;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s, transform 0.2s;
    position: relative; overflow: hidden;
  }
  .assignment-card::before {
    content: ''; position: absolute;
    left: 0; top: 0; bottom: 0; width: 4px;
    background: var(--gold); border-radius: 4px 0 0 4px;
  }
  .assignment-card.overdue::before { background: var(--rust); }
  .assignment-card.ok::before { background: var(--sage); }
  .assignment-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }

  .card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
  .card-subject {
    font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gold); margin-bottom: 3px;
  }
  .card-subject.red { color: var(--rust); }
  .card-subject.green { color: var(--sage); }
  .card-title { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--ink); }
  .card-by { font-size: 12px; color: var(--ink-light); margin-top: 2px; }
  .card-desc { font-size: 13px; color: var(--ink-muted); line-height: 1.65; margin: 10px 0; }
  .card-footer {
    display: flex; align-items: center; gap: 10px;
    margin-top: 12px; padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500;
  }
  .badge-warn { background: var(--gold-pale); color: #8a6220; border: 1px solid var(--gold-light); }
  .badge-danger { background: var(--rust-light); color: var(--rust); border: 1px solid rgba(184,92,58,0.2); }
  .badge-ok { background: var(--sage-light); color: var(--sage); border: 1px solid rgba(74,124,95,0.2); }
  .card-due { font-size: 12px; color: var(--ink-light); margin-left: auto; }

  /* PDF UPLOAD */
  .pdf-drop-zone {
    border: 2px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 20px 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--cream);
    position: relative;
  }
  .pdf-drop-zone:hover, .pdf-drop-zone.drag-over {
    border-color: var(--gold);
    background: var(--gold-pale);
  }
  .pdf-drop-zone input[type="file"] {
    position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
  }
  .pdf-drop-icon { font-size: 28px; margin-bottom: 6px; }
  .pdf-drop-text { font-size: 13px; color: var(--ink-muted); }
  .pdf-drop-text strong { color: var(--gold); }
  .pdf-drop-hint { font-size: 11px; color: var(--ink-light); margin-top: 3px; }

  .pdf-preview {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px;
    background: var(--gold-pale); border: 1px solid var(--gold-light);
    border-radius: var(--radius-sm); margin-top: 8px;
  }
  .pdf-preview-icon { font-size: 20px; flex-shrink: 0; }
  .pdf-preview-name { font-size: 13px; font-weight: 500; color: var(--ink); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pdf-preview-size { font-size: 11px; color: var(--ink-light); flex-shrink: 0; }
  .pdf-remove-btn {
    background: none; border: none; cursor: pointer;
    color: var(--rust); font-size: 16px; padding: 2px 4px;
    border-radius: 4px; flex-shrink: 0; transition: background 0.15s;
  }
  .pdf-remove-btn:hover { background: var(--rust-light); }

  .card-pdf-link {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; margin-top: 4px;
    background: var(--gold-pale); border: 1px solid var(--gold-light);
    border-radius: 20px; font-size: 12px; font-weight: 500; color: #7a5a18;
    text-decoration: none; transition: all 0.2s;
  }
  .card-pdf-link:hover { background: var(--gold-light); color: var(--ink); }

  .card-submission {
    margin-top: 10px; padding: 10px 14px;
    background: var(--sage-light); border: 1px solid rgba(74,124,95,0.25);
    border-radius: var(--radius-sm); font-size: 12px; color: var(--sage);
    display: flex; align-items: center; gap: 8px;
  }
  .card-submission a { color: var(--sage); font-weight: 600; }

  .submit-section { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
  .submit-section .pdf-drop-zone { padding: 12px; }

  .empty-state { text-align: center; padding: 64px 32px; max-width: 340px; margin: 0 auto; }
  .empty-icon { font-size: 44px; margin-bottom: 14px; opacity: 0.35; }
  .empty-title { font-family: var(--font-display); font-size: 19px; color: var(--ink); margin-bottom: 8px; }
  .empty-sub { font-size: 13px; color: var(--ink-light); line-height: 1.65; }

  /* PDF UPLOAD STYLES */
  .pdf-upload-zone {
    border: 2px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 18px 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--cream);
    position: relative;
  }
  .pdf-upload-zone:hover, .pdf-upload-zone.drag-over {
    border-color: var(--gold);
    background: var(--gold-pale);
  }
  .pdf-upload-zone input[type="file"] {
    position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
  }
  .pdf-upload-icon { font-size: 28px; margin-bottom: 6px; }
  .pdf-upload-label { font-size: 13px; color: var(--ink-muted); line-height: 1.5; }
  .pdf-upload-label strong { color: var(--gold); }
  .pdf-upload-label small { display: block; font-size: 11px; color: var(--ink-light); margin-top: 3px; }

  .pdf-preview {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
    background: var(--gold-pale);
    border: 1px solid var(--gold-light);
    border-radius: var(--radius-sm);
    margin-top: 8px;
  }
  .pdf-preview-icon { font-size: 22px; flex-shrink: 0; }
  .pdf-preview-info { flex: 1; min-width: 0; }
  .pdf-preview-name { font-size: 13px; font-weight: 500; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pdf-preview-size { font-size: 11px; color: var(--ink-light); margin-top: 2px; }
  .pdf-remove-btn {
    background: none; border: none; cursor: pointer;
    color: var(--rust); font-size: 16px; padding: 2px 6px;
    border-radius: 4px; transition: background 0.15s;
    flex-shrink: 0;
  }
  .pdf-remove-btn:hover { background: var(--rust-light); }

  .pdf-link {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px;
    background: var(--gold-pale); color: #8a6220;
    border: 1px solid var(--gold-light);
    border-radius: 20px; font-size: 12px; font-weight: 500;
    text-decoration: none; cursor: pointer;
    transition: all 0.15s;
  }
  .pdf-link:hover { background: var(--gold-light); }

  .student-submit-section {
    margin-top: 14px; padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .student-submit-label {
    font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-muted); margin-bottom: 8px;
  }
  .btn-submit-pdf {
    padding: 7px 16px; font-family: var(--font-body); font-size: 13px; font-weight: 500;
    color: var(--sage); background: var(--sage-light);
    border: 1px solid rgba(74,124,95,0.3);
    border-radius: var(--radius-sm); cursor: pointer; transition: all 0.2s;
    margin-top: 8px;
  }
  .btn-submit-pdf:hover { background: rgba(74,124,95,0.2); }
  .submission-status {
    font-size: 12px; margin-top: 6px;
    padding: 5px 10px; border-radius: var(--radius-xs);
  }
  .submission-status.submitted { background: var(--sage-light); color: var(--sage); }
  .submission-status.pending { background: var(--gold-pale); color: #8a6220; }

  @media (max-width: 768px) {
    .landing-wrap { grid-template-columns: 1fr; }
    .landing-hero { display: none; }
    .landing-form-side { padding: 40px 24px; }
    .dashboard-wrap { grid-template-columns: 1fr; }
    .sidebar { display: none; }
    .main-content { padding: 24px 20px; }
    .field-row { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<!-- LANDING -->
<div id="landing" class="screen active">
  <div class="landing-wrap">
    <div class="landing-hero">
      <div class="hero-deco"></div>
      <div class="hero-logo"><span></span> EduSync</div>
      <h1 class="hero-title">Where <em>learning</em><br>meets clarity.</h1>
      <p class="hero-sub">A unified portal for teachers to publish assignments and students to track their academic journey — seamlessly.</p>
      <div class="hero-stats">
        <div class="stat"><div class="stat-num">∞</div><div class="stat-label">Assignments</div></div>
        <div class="stat"><div class="stat-num">2</div><div class="stat-label">Roles</div></div>
        <div class="stat"><div class="stat-num">1</div><div class="stat-label">Platform</div></div>
      </div>
    </div>

    <div class="landing-form-side">
      <div class="form-header">
        <h2>Welcome back</h2>
        <p>Sign in to your account or create a new one</p>
      </div>

      <div class="role-tabs">
        <button class="role-tab active" onclick="switchRole('student')">🎓 Student</button>
        <button class="role-tab" onclick="switchRole('teacher')">📋 Teacher</button>
      </div>

      <div id="msg-landing" class="msg"></div>

      <div id="login-form">
        <div class="field">
          <label>Your ID</label>
          <input type="text" id="login-id" placeholder="Enter your student / teacher ID">
        </div>
        <div class="field">
          <label>Password</label>
          <input type="password" id="login-pw" placeholder="Enter your password">
        </div>
        <button class="btn-primary" onclick="doLogin()">Sign In →</button>
        <span class="link-toggle" onclick="showRegister()">New here? <strong>Create an account</strong></span>
      </div>

      <div id="register-form" style="display:none">
        <div class="field">
          <label>Full Name</label>
          <input type="text" id="reg-name" placeholder="Your full name">
        </div>
        <div class="field">
          <label>Choose an ID</label>
          <input type="text" id="reg-id" placeholder="e.g. STU2025 or TCH001">
        </div>
        <div class="field-row">
          <div class="field" style="margin:0">
            <label>Password</label>
            <input type="password" id="reg-pw" placeholder="Set password">
          </div>
          <div class="field" style="margin:0">
            <label>Confirm</label>
            <input type="password" id="reg-pw2" placeholder="Repeat it">
          </div>
        </div>
        <br>
        <button class="btn-primary" onclick="doRegister()">Create Account →</button>
        <span class="link-toggle" onclick="showLogin()">Already registered? <strong>Sign in</strong></span>
      </div>
    </div>
  </div>
</div>

<!-- TEACHER DASHBOARD -->
<div id="teacher-dashboard" class="screen">
  <div class="dashboard-wrap">
    <div class="topbar">
      <div class="topbar-brand"><div class="live-dot"></div> EduSync</div>
      <div class="topbar-right">
        <div class="user-chip">
          <div class="user-info">
            <div class="user-name" id="teacher-name-top"></div>
            <div class="user-role">Teacher</div>
          </div>
          <div id="teacher-avatar" class="avatar"></div>
        </div>
        <button class="btn-signout" onclick="logout()">Sign out</button>
      </div>
    </div>

    <div class="sidebar">
      <div class="sidebar-label">Navigation</div>
      <button class="nav-item active" id="nav-post" onclick="teacherTab('post')">
        <span class="nav-icon">✏️</span> Post Assignment
      </button>
      <button class="nav-item" id="nav-view" onclick="teacherTab('view')">
        <span class="nav-icon">📚</span> All Assignments
      </button>
    </div>

    <div class="main-content">
      <div id="teacher-post-panel">
        <div class="page-header">
          <div class="page-title">New Assignment</div>
          <div class="page-sub">Publish a new assignment for your students</div>
        </div>
        <div class="form-card">
          <h3>Assignment Details</h3>
          <div class="field">
            <label>Subject</label>
            <input type="text" id="t-subject" placeholder="e.g. Mathematics, History, Physics…">
          </div>
          <div class="field">
            <label>Title</label>
            <input type="text" id="t-title" placeholder="A clear, descriptive title">
          </div>
          <div class="field">
            <label>Description</label>
            <textarea id="t-desc" placeholder="Instructions, context, resources…"></textarea>
          </div>
          <div class="field-row">
            <div class="field" style="margin:0">
              <label>Publish Date</label>
              <input type="date" id="t-publish">
            </div>
            <div class="field" style="margin:0">
              <label>Due Date</label>
              <input type="date" id="t-due">
            </div>
          </div>
          <div class="field" style="margin-top:14px">
            <label>Attachment (PDF, optional)</label>
            <div class="pdf-drop-zone" id="teacher-drop-zone"
              ondragover="handleDragOver(event,'teacher-drop-zone')"
              ondragleave="handleDragLeave('teacher-drop-zone')"
              ondrop="handleDrop(event,'teacher-pdf-input','teacher-pdf-preview','teacher-pdf-data','teacher-drop-zone')">
              <input type="file" id="teacher-pdf-input" accept=".pdf"
                onchange="handleFileSelect(this,'teacher-pdf-preview','teacher-pdf-data','teacher-drop-zone')">
              <div class="pdf-drop-icon">📎</div>
              <div class="pdf-drop-text"><strong>Click to browse</strong> or drag &amp; drop a PDF</div>
              <div class="pdf-drop-hint">Max file size: 5 MB</div>
            </div>
            <div id="teacher-pdf-preview" style="display:none" class="pdf-preview">
              <span class="pdf-preview-icon">📄</span>
              <span class="pdf-preview-name" id="teacher-pdf-name"></span>
              <span class="pdf-preview-size" id="teacher-pdf-size"></span>
              <button class="pdf-remove-btn" onclick="removePdf('teacher-pdf-input','teacher-pdf-preview','teacher-pdf-data','teacher-drop-zone')" title="Remove">&#x2715;</button>
            </div>
          </div>
          <input type="hidden" id="teacher-pdf-data">
          <input type="hidden" id="teacher-pdf-filename">
          <br>
          <div id="msg-post" class="msg"></div>
          <button class="btn-primary" onclick="postAssignment()">Publish Assignment &#x2192;</button>
        </div>
      </div>

      <div id="teacher-view-panel" style="display:none">
        <div class="page-header">
          <div class="page-title">Your Assignments</div>
          <div class="page-sub">All assignments you've posted</div>
        </div>
        <div id="teacher-assignments-list" class="assignments-grid"></div>
      </div>
    </div>
  </div>
</div>

<!-- STUDENT DASHBOARD -->
<div id="student-dashboard" class="screen">
  <div class="dashboard-wrap">
    <div class="topbar">
      <div class="topbar-brand"><div class="live-dot"></div> EduSync</div>
      <div class="topbar-right">
        <div class="user-chip">
          <div class="user-info">
            <div class="user-name" id="student-name-top"></div>
            <div class="user-role">Student</div>
          </div>
          <div id="student-avatar" class="avatar"></div>
        </div>
        <button class="btn-signout" onclick="logout()">Sign out</button>
      </div>
    </div>

    <div class="sidebar">
      <div class="sidebar-label">Navigation</div>
      <button class="nav-item active">
        <span class="nav-icon">📋</span> My Assignments
      </button>
    </div>

    <div class="main-content">
      <div class="page-header">
        <div class="page-title">Your Assignments</div>
        <div class="page-sub">Assignments published for you</div>
      </div>
      <div id="student-assignments-list" class="assignments-grid"></div>
    </div>
  </div>
</div>

<script>
const DB = {
  users: JSON.parse(localStorage.getItem('portal_users') || '{}'),
  assignments: JSON.parse(localStorage.getItem('portal_assignments') || '[]'),
  save() {
    localStorage.setItem('portal_users', JSON.stringify(this.users));
    localStorage.setItem('portal_assignments', JSON.stringify(this.assignments));
  }
};

let currentRole = 'student';
let currentUser = null;

function switchRole(r) {
  currentRole = r;
  document.querySelectorAll('.role-tab').forEach((t, i) => {
    t.classList.toggle('active', (i===0&&r==='student')||(i===1&&r==='teacher'));
  });
  clearMsg('msg-landing');
}
function showRegister(){ document.getElementById('login-form').style.display='none'; document.getElementById('register-form').style.display='block'; clearMsg('msg-landing'); }
function showLogin(){ document.getElementById('register-form').style.display='none'; document.getElementById('login-form').style.display='block'; clearMsg('msg-landing'); }
function showMsg(id,text,type){ const el=document.getElementById(id); el.textContent=text; el.className='msg '+type; }
function clearMsg(id){ const el=document.getElementById(id); el.className='msg'; el.textContent=''; }

function doRegister(){
  const name=document.getElementById('reg-name').value.trim();
  const id=document.getElementById('reg-id').value.trim();
  const pw=document.getElementById('reg-pw').value;
  const pw2=document.getElementById('reg-pw2').value;
  if(!name||!id||!pw) return showMsg('msg-landing','Please fill in all fields.','err');
  if(pw!==pw2) return showMsg('msg-landing','Passwords do not match.','err');
  const key=currentRole+':'+id;
  if(DB.users[key]) return showMsg('msg-landing','That ID is already taken.','err');
  DB.users[key]={name,id,pw,role:currentRole};
  DB.save();
  showMsg('msg-landing','Account created! You can now sign in.','ok');
  showLogin();
}

function doLogin(){
  const id=document.getElementById('login-id').value.trim();
  const pw=document.getElementById('login-pw').value;
  const key=currentRole+':'+id;
  const user=DB.users[key];
  if(!user||user.pw!==pw) return showMsg('msg-landing','Invalid ID or password.','err');
  currentUser=user;
  if(user.role==='teacher') openTeacher(); else openStudent();
}

function initials(name){ return name.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2); }

function openTeacher(){
  show('teacher-dashboard');
  document.getElementById('teacher-name-top').textContent=currentUser.name;
  document.getElementById('teacher-avatar').textContent=initials(currentUser.name);
  setTodayMin();
}
function openStudent(){
  show('student-dashboard');
  document.getElementById('student-name-top').textContent=currentUser.name;
  document.getElementById('student-avatar').textContent=initials(currentUser.name);
  renderStudentAssignments();
}
function show(id){ document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active')); document.getElementById(id).classList.add('active'); }

function logout(){
  currentUser=null;
  document.getElementById('login-id').value='';
  document.getElementById('login-pw').value='';
  clearMsg('msg-landing');
  show('landing');
}

function setTodayMin(){
  const today=new Date().toISOString().split('T')[0];
  document.getElementById('t-publish').value=today;
  document.getElementById('t-publish').min=today;
  document.getElementById('t-due').min=today;
}

function teacherTab(tab){
  document.getElementById('teacher-post-panel').style.display=tab==='post'?'block':'none';
  document.getElementById('teacher-view-panel').style.display=tab==='view'?'block':'none';
  document.getElementById('nav-post').classList.toggle('active',tab==='post');
  document.getElementById('nav-view').classList.toggle('active',tab==='view');
  if(tab==='view') renderTeacherAssignments();
}

/* ── PDF helpers ── */
const MAX_PDF_BYTES = 5*1024*1024;

function fmtSize(b){ return b<1024?b+'B':b<1048576?(b/1024).toFixed(1)+' KB':(b/1048576).toFixed(1)+' MB'; }

function handleDragOver(e, zoneId){ e.preventDefault(); document.getElementById(zoneId).classList.add('drag-over'); }
function handleDragLeave(zoneId){ document.getElementById(zoneId).classList.remove('drag-over'); }

function handleDrop(e, inputId, previewId, dataId, zoneId){
  e.preventDefault();
  document.getElementById(zoneId).classList.remove('drag-over');
  const file=e.dataTransfer.files[0];
  if(file) processPdfFile(file, inputId, previewId, dataId, zoneId);
}

function handleFileSelect(input, previewId, dataId, zoneId){
  const file=input.files[0];
  if(file) processPdfFile(file, input.id, previewId, dataId, zoneId);
}

function processPdfFile(file, inputId, previewId, dataId, zoneId){
  if(file.type!=='application/pdf'&&!file.name.endsWith('.pdf')){ alert('Please upload a PDF file only.'); return; }
  if(file.size>MAX_PDF_BYTES){ alert('File too large. Maximum size is 5 MB.'); return; }
  const reader=new FileReader();
  reader.onload=function(ev){
    document.getElementById(dataId).value=ev.target.result;
    if(dataId==='teacher-pdf-data') document.getElementById('teacher-pdf-filename').value=file.name;
    const preview=document.getElementById(previewId);
    preview.querySelector('.pdf-preview-name').textContent=file.name;
    preview.querySelector('.pdf-preview-size').textContent=fmtSize(file.size);
    preview.style.display='flex';
    document.getElementById(zoneId).style.display='none';
  };
  reader.readAsDataURL(file);
}

function removePdf(inputId, previewId, dataId, zoneId){
  document.getElementById(dataId).value='';
  if(dataId==='teacher-pdf-data'&&document.getElementById('teacher-pdf-filename')) document.getElementById('teacher-pdf-filename').value='';
  document.getElementById(previewId).style.display='none';
  document.getElementById(zoneId).style.display='block';
  const input=document.getElementById(inputId);
  if(input) input.value='';
}

function openPdf(dataUrl, filename){
  const link=document.createElement('a');
  link.href=dataUrl; link.download=filename||'file.pdf'; link.target='_blank';
  link.click();
}

/* ── Teacher: post assignment ── */
function postAssignment(){
  const subject=document.getElementById('t-subject').value.trim();
  const title=document.getElementById('t-title').value.trim();
  const desc=document.getElementById('t-desc').value.trim();
  const publish=document.getElementById('t-publish').value;
  const due=document.getElementById('t-due').value;
  if(!subject||!title||!publish||!due) return showMsg('msg-post','Please fill in all required fields.','err');
  if(due<publish) return showMsg('msg-post','Due date cannot be before publish date.','err');
  const pdfData=document.getElementById('teacher-pdf-data').value;
  const pdfName=document.getElementById('teacher-pdf-filename').value;
  DB.assignments.push({
    id:Date.now(), subject, title, desc, publish, due,
    teacher:currentUser.id, teacherName:currentUser.name,
    pdfData:pdfData||null, pdfName:pdfName||null,
    submissions:{}
  });
  DB.save();
  showMsg('msg-post','Assignment published successfully!','ok');
  ['t-subject','t-title','t-desc','t-due'].forEach(f=>document.getElementById(f).value='');
  removePdf('teacher-pdf-input','teacher-pdf-preview','teacher-pdf-data','teacher-drop-zone');
  setTodayMin();
}

/* ── Teacher: view assignments (with student submissions) ── */
function renderTeacherAssignments(){
  const mine=DB.assignments.filter(a=>a.teacher===currentUser.id);
  const el=document.getElementById('teacher-assignments-list');
  if(!mine.length){ el.innerHTML='<div class="empty-state"><div class="empty-icon">📭</div><div class="empty-title">Nothing posted yet</div><div class="empty-sub">Switch to &ldquo;Post Assignment&rdquo; to publish your first one.</div></div>'; return; }
  el.innerHTML=mine.map(a=>{
    const subs=a.submissions||{};
    const subCount=Object.keys(subs).length;
    const pdfBtn=a.pdfData?'<button class="pdf-link" onclick="openPdf(DB.assignments.find(x=>x.id==='+a.id+').pdfData,\''+escAttr(a.pdfName||'attachment.pdf')+'\')">📄 '+esc(a.pdfName||'attachment.pdf')+'</button>':'';
    const subsHtml=subCount>0
      ?'<details style="margin-top:10px"><summary style="font-size:12px;color:var(--ink-muted);cursor:pointer">'+subCount+' submission'+(subCount>1?'s':'')+' received</summary><div style="margin-top:8px;display:flex;flex-direction:column;gap:6px">'+
        Object.entries(subs).map(([sid,sub])=>
          '<div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--sage-light);border-radius:6px;font-size:12px">'+
          '<span>👤 <strong>'+esc(sub.studentName)+'</strong></span>'+
          '<span style="color:var(--ink-light)">'+sub.submittedAt+'</span>'+
          '<button class="pdf-link" style="margin-left:auto" onclick="openPdf(DB.assignments.find(x=>x.id==='+a.id+').submissions[\''+sid+'\'].pdfData,\''+escAttr(sub.pdfName||'submission.pdf')+'\')">📥 '+esc(sub.pdfName||'submission.pdf')+'</button>'+
          '</div>'
        ).join('')+
        '</div></details>'
      :'<div style="font-size:12px;color:var(--ink-light);margin-top:8px">No submissions yet</div>';
    return '<div class="assignment-card">'+
      '<div class="card-top"><div>'+
      '<div class="card-subject">'+esc(a.subject)+'</div>'+
      '<div class="card-title">'+esc(a.title)+'</div>'+
      '</div><button class="btn-danger" onclick="deleteAssignment('+a.id+')">Delete</button></div>'+
      (a.desc?'<div class="card-desc">'+esc(a.desc)+'</div>':'')+
      '<div class="card-footer" style="flex-wrap:wrap;gap:8px">'+
      '<span class="badge badge-warn">📅 Publishes '+a.publish+'</span>'+
      '<span class="badge badge-danger">⏰ Due '+a.due+'</span>'+
      pdfBtn+'</div>'+subsHtml+'</div>';
  }).join('');
}

function deleteAssignment(id){
  DB.assignments=DB.assignments.filter(a=>a.id!==id);
  DB.save();
  renderTeacherAssignments();
}

/* ── Student: view assignments + submit PDF ── */
function renderStudentAssignments(){
  const today=new Date().toISOString().split('T')[0];
  const visible=DB.assignments.filter(a=>a.publish<=today);
  const el=document.getElementById('student-assignments-list');
  if(!visible.length){ el.innerHTML='<div class="empty-state"><div class="empty-icon">📬</div><div class="empty-title">No assignments yet</div><div class="empty-sub">Your teachers haven\'t posted anything yet. Check back soon!</div></div>'; return; }
  el.innerHTML=visible.map(a=>{
    const overdue=a.due<today;
    const daysLeft=Math.ceil((new Date(a.due)-new Date(today))/(86400000));
    const label=overdue?'Overdue':daysLeft===0?'Due today!':daysLeft===1?'Due tomorrow':'Due in '+daysLeft+' days';
    const badgeClass=overdue?'badge-danger':daysLeft<=2?'badge-warn':'badge-ok';
    const icon=overdue?'🔴':daysLeft<=2?'🟡':'🟢';
    const cardClass=overdue?'overdue':daysLeft>2?'ok':'';
    const pdfBtn=a.pdfData?'<button class="pdf-link" onclick="openPdf(DB.assignments.find(x=>x.id==='+a.id+').pdfData,\''+escAttr(a.pdfName||'assignment.pdf')+'\')">📄 '+esc(a.pdfName||'Download PDF')+'</button>':'';
    const sub=(a.submissions||{})[currentUser.id];
    const submitSection='<div class="student-submit-section">'+
      '<div class="student-submit-label">Your Submission</div>'+
      (sub
        ?'<div class="submission-status submitted">✅ Submitted on '+sub.submittedAt+'</div>'+
         '<button class="pdf-link" style="margin-top:6px" onclick="openPdf(DB.assignments.find(x=>x.id==='+a.id+').submissions[currentUser.id].pdfData,\''+escAttr(sub.pdfName||'my-submission.pdf')+'\')">📥 View my submission</button>'+
         '<div style="font-size:11px;color:var(--ink-light);margin-top:6px">Re-upload below to replace your submission</div>'
        :'<div class="submission-status pending">📤 Not submitted yet</div>')+
      '<div style="margin-top:10px">'+
      '<div class="pdf-drop-zone" id="sdz-'+a.id+'" ondragover="handleDragOver(event,\'sdz-'+a.id+'\')" ondragleave="handleDragLeave(\'sdz-'+a.id+'\')" ondrop="handleDrop(event,\'sdi-'+a.id+'\',\'sdp-'+a.id+'\',\'sdd-'+a.id+'\',\'sdz-'+a.id+'\')">'+
        '<input type="file" id="sdi-'+a.id+'" accept=".pdf" onchange="handleFileSelect(this,\'sdp-'+a.id+'\',\'sdd-'+a.id+'\',\'sdz-'+a.id+'\')">'+
        '<div class="pdf-drop-icon">📎</div>'+
        '<div class="pdf-drop-text"><strong>Click to upload</strong> or drag &amp; drop</div>'+
        '<div class="pdf-drop-hint">PDF only &middot; Max 5 MB</div>'+
      '</div>'+
      '<div id="sdp-'+a.id+'" style="display:none" class="pdf-preview">'+
        '<span class="pdf-preview-icon">📄</span>'+
        '<span class="pdf-preview-name"></span>'+
        '<span class="pdf-preview-size"></span>'+
        '<button class="pdf-remove-btn" onclick="removePdf(\'sdi-'+a.id+'\',\'sdp-'+a.id+'\',\'sdd-'+a.id+'\',\'sdz-'+a.id+'\')" title="Remove">&#x2715;</button>'+
      '</div>'+
      '<input type="hidden" id="sdd-'+a.id+'">'+
      '<button class="btn-submit-pdf" onclick="submitAssignment('+a.id+')">Submit PDF &#x2192;</button>'+
      '<div id="smsg-'+a.id+'" class="msg" style="margin-top:6px"></div>'+
      '</div></div>';
    return '<div class="assignment-card '+cardClass+'">'+
      '<div class="card-top"><div>'+
      '<div class="card-subject'+(overdue?' red':daysLeft>2?' green':'')+'">'+esc(a.subject)+'</div>'+
      '<div class="card-title">'+esc(a.title)+'</div>'+
      '<div class="card-by">by '+esc(a.teacherName)+'</div>'+
      '</div><span class="badge '+badgeClass+'">'+icon+' '+label+'</span></div>'+
      (a.desc?'<div class="card-desc">'+esc(a.desc)+'</div>':'')+
      '<div class="card-footer" style="flex-wrap:wrap;gap:8px">'+
      '<span class="badge badge-warn">📅 Published '+a.publish+'</span>'+
      '<span class="card-due">Due: <strong>'+a.due+'</strong></span>'+
      pdfBtn+'</div>'+submitSection+'</div>';
  }).join('');
}

function submitAssignment(assignmentId){
  const msgEl=document.getElementById('smsg-'+assignmentId);
  const pdfData=document.getElementById('sdd-'+assignmentId).value;
  const pdfInput=document.getElementById('sdi-'+assignmentId);
  const pdfName=pdfInput&&pdfInput.files[0]?pdfInput.files[0].name:'submission.pdf';
  if(!pdfData){ msgEl.textContent='Please select a PDF to upload.'; msgEl.className='msg err'; return; }
  const idx=DB.assignments.findIndex(a=>a.id===assignmentId);
  if(idx===-1) return;
  if(!DB.assignments[idx].submissions) DB.assignments[idx].submissions={};
  const now=new Date();
  const ts=now.toLocaleDateString()+' '+now.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  DB.assignments[idx].submissions[currentUser.id]={
    studentId:currentUser.id, studentName:currentUser.name,
    pdfData, pdfName, submittedAt:ts
  };
  DB.save();
  msgEl.textContent='Submitted successfully!'; msgEl.className='msg ok';
  setTimeout(()=>renderStudentAssignments(),1200);
}

function esc(s){ return s?s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'):''; }
function escAttr(s){ return s?s.replace(/'/g,'&#39;').replace(/"/g,'&quot;'):''; }
</script>
